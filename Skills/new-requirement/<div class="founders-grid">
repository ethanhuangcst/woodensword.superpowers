<div id="wechat-modal" class="wechat-modal">
  <div class="wechat-modal-content">
    <button type="button" class="wechat-close" aria-label="Close">×</button>
    <div id="wechat-modal-body"></div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var triggers = document.querySelectorAll('.wechat-trigger');
  var modal = document.getElementById('wechat-modal');
  var modalBody = document.getElementById('wechat-modal-body');
  var closeBtn = document.querySelector('.wechat-close');

  if (!triggers.length || !modal || !modalBody || !closeBtn) return;

  triggers.forEach(function (trigger) {
    trigger.addEventListener('click', function (e) {
      e.preventDefault();
      var qr = this.getAttribute('data-wechat');

      modalBody.innerHTML =
        '<p>Scan the QR code to contact via WeChat</p>' +
        '<img src="' + qr + '" alt="WeChat QR Code">';

      modal.classList.add('is-active');
    });
  });

  closeBtn.addEventListener('click', function () {
    modal.classList.remove('is-active');
  });

  modal.addEventListener('click', function (e) {
    if (e.target === modal) {
      modal.classList.remove('is-active');
    }
  });
});
</script>
